spawn-at-startup "nix" "run" "--impure" "github:guibou/nixGL" "--" "quickshell"
spawn-at-startup "swaybg" "-i" "/home/liamh/backgrounds/fall.jpg" "-m" "fill"
spawn-at-startup "xwayland-satellite"

prefer-no-csd

output "eDP-1" {
    scale 1
}

layout {
    gaps 0

    background-color "transparent"

    empty-workspace-above-first

    focus-ring {
        off
    }

    insert-hint {
        off
    }
}

input {
    focus-follows-mouse

    touchpad {
        accel-speed 0.225
        scroll-factor 1

        tap
        click-method "clickfinger"
    }
}

binds {
    Mod+Q { spawn "alacritty"; }
    Mod+C { close-window; }
    Mod+S { spawn "qs" "ipc" "call" "launcher" "toggle"; }
    Mod+A { switch-preset-column-width; }
    Mod+D { maximize-column; }
    Mod+F { spawn "hyprshot" "-m" "region" "--clipboard-only"; }
}

layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

window-rule {
    match title="^QML Launcher$"
    open-floating true
    open-focused true
    default-column-width { fixed 600; }
    default-window-height { fixed 400; }
}

window-rule {
    match app-id="code"
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id="com.github.flxzt.rnote"
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id="vesktop"
    default-column-width { proportion 1.0; }
}

cursor {
    xcursor-theme "rose-pine"
    xcursor-size 24
}

gestures {
    hot-corners {
        off
    }
}

hotkey-overlay {
    skip-at-startup
}

animations {
    window-open {
        duration-ms 300
        curve "cubic-bezier" 0.2 1.05 0.3 1.05
    }

    window-close {
        duration-ms 300
        curve "cubic-bezier" 0.3 -0.3 0 1
    }

    window-movement {
        duration-ms 300
        curve "cubic-bezier" 0.05 0.9 0.1 1.05
    }

    horizontal-view-movement {
        spring damping-ratio=0.88 stiffness=1200 epsilon=0.0001
    }

    workspace-switch {
        duration-ms 300
        curve "cubic-bezier" 0.05 0.9 0.1 1.05
    }
}